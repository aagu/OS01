     }
 
     fclose (f);
+#elif defined(OS01_DOOM)
+    // OS01: a line-oriented loader.  It never uses fscanf(): the whole
+    // entry is read with fgets() and converted with the checked parsers
+    // above, so a general "fscanf" dependency is not introduced.
+    //
+    // The rules are:
+    //   * the read is bounded -- a line that does not fit is dropped
+    //     WHOLE and the input resynchronises on the next newline;
+    //   * the input always advances, so a bad line cannot spin;
+    //   * a read error terminates instead of looping on feof();
+    //   * a missing file is the normal first-run case, any other open
+    //     error is reported.
+    FILE *f;
+    default_t *def;
+    char line[256];
+
+    errno = 0;
+    f = fopen(collection->filename, "r");
+
+    if (f == NULL)
+    {
+        if (errno != ENOENT)
+        {
+            I_Error("Could not open config file %s", collection->filename);
+        }
+
+        // No config file yet: the normal first-run case.
+        return;
+    }
+
+    while (fgets(line, sizeof(line), f) != NULL)
+    {
+        size_t len = strlen(line);
+        char *name;
+        char *value;
+        char *p;
+
+        if (len > 0 && line[len - 1] == '\n')
+        {
+            line[--len] = '\0';
+        }
+        else if (len + 1 == sizeof(line))
+        {
+            // The line does not fit: drop it WHOLE and resynchronise on
+            // the next newline.  A truncated line is never applied.
+            int c;
+
+            while ((c = fgetc(f)) != EOF && c != '\n')
+            {
+            }
+
+            continue;
+        }
+
+        // Strip the carriage return of DOS text files.
+        while (len > 0 && !isprint(line[len - 1]))
+        {
+            line[--len] = '\0';
+        }
+
+        p = line;
+
+        while (*p == ' ' || *p == '\t')
+        {
+            ++p;
+        }
+
+        if (*p == '\0')
+        {
+            // Empty line: ignore it.
+            continue;
+        }
+
+        name = p;
+
+        while (*p != '\0' && *p != ' ' && *p != '\t')
+        {
+            ++p;
+        }
+
+        if (*p != '\0')
+        {
+            *p++ = '\0';
+        }
+
+        if (strlen(name) >= 80)
+        {
+            fprintf(stderr, "Config: ignoring malformed entry in %s\n",
+                    collection->filename);
+            continue;
+        }
+
+        while (*p == ' ' || *p == '\t')
+        {
+            ++p;
+        }
+
+        value = p;
+
+        // Find the setting in the list.
+        def = SearchCollection(collection, name);
+
+        if (def == NULL || !def->bound)
+        {
+            // Unknown variable?  Unbound variables are also treated as
+            // unknown.
+            continue;
+        }
+
+        // Surrounded by quotes? If so, remove them.
+        if (strlen(value) >= 2
+         && value[0] == '"' && value[strlen(value) - 1] == '"')
+        {
+            value[strlen(value) - 1] = '\0';
+            memmove(value, value + 1, strlen(value) + 1);
+        }
+
+        SetVariableChecked(def, value);
+    }
+
+    if (ferror(f))
+    {
+        // A read error must terminate, not spin on feof().
+        fclose(f);
+        I_Error("Error reading config file %s", collection->filename);
+    }
+
+    fclose(f);
 #endif
 }
 

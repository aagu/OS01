+#if defined(OS01_DOOM)
+// OS01: a CHECKED integer parse.  The upstream ParseIntParameter leaves
+// its output untouched when the conversion fails, so a broken config line
+// would install whatever happened to be on the stack.  strtol() with base
+// 0 has the same semantics as the upstream "%i" (decimal, 0-prefixed
+// octal and 0x-prefixed hexadecimal) and reports where it stopped.
+static boolean ParseIntParameterChecked(const char *strparm, int *parm)
+{
+    char *end = NULL;
+    long value;
+
+    if (strparm == NULL || *strparm == '\0')
+    {
+        return false;
+    }
+
+    errno = 0;
+    value = strtol(strparm, &end, 0);
+
+    if (end == strparm || end == NULL || *end != '\0')
+    {
+        return false;
+    }
+
+    if (errno == ERANGE || value < INT_MIN || value > INT_MAX)
+    {
+        return false;
+    }
+
+    *parm = (int) value;
+    return true;
+}
+
+// OS01: a CHECKED float parse, with the same intent as the upstream
+// atof(): the whole value must be consumed and the result must be
+// representable.
+static boolean ParseFloatParameterChecked(const char *strparm, float *value)
+{
+    char *end = NULL;
+    float result;
+
+    if (strparm == NULL || *strparm == '\0')
+    {
+        return false;
+    }
+
+    errno = 0;
+    result = strtof(strparm, &end);
+
+    if (end == strparm || end == NULL || *end != '\0')
+    {
+        return false;
+    }
+
+    if (errno == ERANGE)
+    {
+        return false;
+    }
+
+    *value = result;
+    return true;
+}
+
+// OS01: the OS01 loader installs a value only when the whole entry is
+// usable.  A broken number and an unmappable key code keep the DEFAULT
+// and are reported: an invalid binding is never generated.
+static void SetVariableChecked(default_t *def, char *value)
+{
+    switch (def->type)
+    {
+        case DEFAULT_STRING:
+            * (char **) def->location = strdup(value);
+            break;
+
+        case DEFAULT_INT:
+        case DEFAULT_INT_HEX:
+        {
+            int parm;
+
+            if (!ParseIntParameterChecked(value, &parm))
+            {
+                fprintf(stderr,
+                        "Config: ignoring invalid value \"%s\" for %s\n",
+                        value, def->name);
+                return;
+            }
+
+            * (int *) def->location = parm;
+            break;
+        }
+
+        case DEFAULT_KEY:
+        {
+            int intparm;
+
+            if (!ParseIntParameterChecked(value, &intparm))
+            {
+                fprintf(stderr,
+                        "Config: ignoring invalid key \"%s\" for %s\n",
+                        value, def->name);
+                return;
+            }
+
+            if (intparm < 0 || intparm >= 128)
+            {
+                fprintf(stderr,
+                        "Config: ignoring unmappable key %d for %s\n",
+                        intparm, def->name);
+                return;
+            }
+
+            // Keep the vanilla scancode so that the saver writes it back.
+            def->untranslated = intparm;
+            def->original_translated = scantokey[intparm];
+            * (int *) def->location = def->original_translated;
+            break;
+        }
+
+        case DEFAULT_FLOAT:
+        {
+            float parm;
+
+            if (!ParseFloatParameterChecked(value, &parm))
+            {
+                fprintf(stderr,
+                        "Config: ignoring invalid value \"%s\" for %s\n",
+                        value, def->name);
+                return;
+            }
+
+            * (float *) def->location = parm;
+            break;
+        }
+    }
+}
+#endif

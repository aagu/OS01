{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch QEMU",
            "type": "shell",
            "isBackground": true,
            "linux": {
                "command": "DEBUG=1 make debug DEBUG_CHANNELS=sched,tty,vfs,mm,fs,net,ipc,drivers,init,syscall OS01_SELFTEST=1"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*OVMF\\.fd.*probing guessed raw"
                }
            }
        },
        {
            "label": "Build AArch64 kernel (debug)",
            "type": "shell",
            "command": "make",
            "args": ["-C", "kernel", "ARCH=aarch64", "DEBUG=1"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start AArch64 QEMU (GDB)",
            "type": "shell",
            "command": "make",
            "args": ["debug-aarch64"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "aarch64-qemu",
                "pattern": [
                    {
                        "regexp": "^AArch64 QEMU GDB server listening on tcp://127\\.0\\.0\\.1:1234$"
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^AArch64 QEMU GDB server listening on tcp://127\\.0\\.0\\.1:1234$",
                    "endsPattern": "^AArch64 QEMU GDB server listening on tcp://127\\.0\\.0\\.1:1234$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}

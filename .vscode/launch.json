{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel/kernel.elf",
            "args": [],
            "targetArchitecture": "x86",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/toolchain/cross/bin/x86_64-elf-gdb",
            "customLaunchSetupCommands": [
                {
                    "text": "target remote localhost:1234",
                    "description": "Connect to QEMU remote debugger"
                }
            ],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "file ${workspaceFolder}/build/x86_64/kernel/kernel.elf",
                    "description": "Load binary"
                }
            ],
            "preLaunchTask": "Launch QEMU"
        },
        {
            "name": "Launch with LLDB",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/x86_64/kernel/kernel.elf",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build/x86_64/kernel/kernel.elf"
            ],
            "attachCommands": [
                "gdb-remote 1234"
            ],
            "preLaunchTask": "Launch QEMU"
        },
        {
            "name": "debug systest with LLDB",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/x86_64/user/systest.elf",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build/x86_64/user/systest.elf"
            ],
            "attachCommands": [
                "gdb-remote 1234"
            ],
            "preLaunchTask": "Launch QEMU"
        },
        {
            "name": "Debug AArch64 kernel (QEMU)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/aarch64/kernel/kernel.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": true,
            "preLaunchTask": "Start AArch64 QEMU (GDB)",
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Use the AArch64 instruction set before connecting to QEMU",
                    "text": "set architecture aarch64",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}

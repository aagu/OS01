{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // x86_64 调试任务使用 KERNEL_SELFTEST=1，符号文件在 selftest 构建目录。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/x86_64-clang/kernel/selftest/kernel.elf",
            "args": [],
            "targetArchitecture": "x64",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "customLaunchSetupCommands": [
                {
                    "text": "target remote localhost:1234",
                    "description": "Connect to QEMU remote debugger"
                }
            ],
            "setupCommands": [
                {
                    "text": "directory ${workspaceFolder}/kernel",
                    "description": "Find kernel sources"
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Launch QEMU"
        },
        {
            "name": "Launch with LLDB",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/x86_64-clang/kernel/selftest/kernel.elf",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build/x86_64-clang/kernel/selftest/kernel.elf",
                "settings set target.source-map . ${workspaceFolder}/kernel"
            ],
            "attachCommands": [
                "gdb-remote 1234"
            ],
            "preLaunchTask": "Launch QEMU"
        },
        {
            "name": "debug systest with LLDB",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/x86_64/user/systest.elf",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build/x86_64/user/systest.elf"
            ],
            "attachCommands": [
                "gdb-remote 1234"
            ],
            "preLaunchTask": "Launch QEMU"
        },
        {
            "name": "Launch AArch64 with LLDB",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/aarch64-clang/artifacts/kernel.elf",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build/aarch64-clang/artifacts/kernel.elf",
                "platform select remote-aarch64"
            ],
            "attachCommands": [
                "process plugin load",
                "gdb-remote 1234"
            ],
            "preLaunchTask": "Launch QEMU (aarch64, paused for debug)"
        },
        {
            "name": "Launch AArch64 with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/aarch64-clang/artifacts/kernel.elf",
            "targetArchitecture": "arm",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "customLaunchSetupCommands": [
                {
                    "text": "target remote localhost:1234",
                    "description": "Connect to QEMU remote debugger"
                }
            ],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Launch QEMU (aarch64, paused for debug)"
        }
    ]
}

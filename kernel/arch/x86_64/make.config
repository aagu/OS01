# ── Architecture: x86_64 ────────────────────────────────────
# Profile-only guard: the profile was already included by kernel/Makefile via
# OS01_PROFILE_FILE — the toolchain comes from the profile (mk/toolchains/
# clang.mk), never from a local include. This file is only included for
# ARCH=x86_64.
ifeq ($(strip $(OS01_PROFILE_FILE)),)
$(error invoke from the repository root: make PROFILE=x86_64-clang <target>)
endif
OBJFORMAT      ?= elf64-x86-64
ASM            = nasm
ARCH_LINKER    = linker.ld

# Arch-specific CFLAGS
#
# The kernel is linked at 0xffff800000100000, outside -mcmodel=kernel's
# signed 2 GiB range.  Use the large model so non-PIC code emits direct 64-bit
# addresses; -fpie would instead load the stack canary through the GOT.
ARCH_CFLAGS    = -mcmodel=large -ffreestanding -mno-red-zone \
                 -Wall -Wextra -Wframe-larger-than=512 \
                 -mno-80387 -mno-sse -mno-sse2 -mno-3dnow -mno-mmx \
                 -fno-pic -fstack-protector-strong

# Arch-specific linker flags
#
# -static is mandatory: without it the kernel becomes a dynamic PIE with
# unresolved .rela.dyn relocations that objcopy -O binary cannot process.
# (wiki/os01-x86_64-os.md §2)
#
# -Wl,-z,norelro: keep the GOT writable and contiguous; combined with
# -Wl,--no-relax this lets lld emit absolute-address accesses for global
# variables instead of GOT-relative (R_X86_64_GOTPCREL) ones that the
# -mcmodel=kernel + -fpie combination cannot tolerate.  (lld >=17 tightened
# the default GOT-relax policy and would otherwise refuse to convert
# GOTPCREL relocations against variables like `jiffies` or `percpu_data`
# in the final link.)
KERNEL_DRIVER_LDFLAGS := -Wl,-m -Wl,elf_x86_64 -static \
                          -Wl,-z,norelro -Wl,--no-relax
KERNEL_RAW_LDFLAGS    := -m elf_x86_64 -static -z norelro --no-relax
# The raw final link resolves -lk through the stable $(SYSROOT) symlink —
# same reason as kernel/Makefile's -isystem/-L: link library paths must
# survive a sysroot republish so flags and .d/.receipt inputs stay stable.
KERNEL_RAW_LIBDIR     := -L$(SYSROOT)/usr/lib
RAW_LD_EMULATION      := -m elf_x86_64
ARCH_LDFLAGS          = $(KERNEL_DRIVER_LDFLAGS)
ARCH_LIBS             = -nostdlib -lk
ARCH_ENABLE_LWIP = 1

KERNEL_RUNTIME_LINK_GOALS := all kernel.bin \
    $(BUILD_DIR)/kernel.bin $(BUILD_DIR)/kernel.elf \
    $(BUILD_DIR)/kernel.elf.stage1 $(BUILD_DIR)/kernel/kallsyms.o
KERNEL_RUNTIME_LINK_REQUESTED := $(strip $(filter $(KERNEL_RUNTIME_LINK_GOALS),$(MAKECMDGOALS)))$(if $(MAKECMDGOALS),,default)
ifneq ($(KERNEL_RUNTIME_LINK_REQUESTED),)
ifeq ($(strip $(KERNEL_RUNTIME_INPUTS)),)
$(error x86_64 kernel link requires nonempty KERNEL_RUNTIME_INPUTS from the root runtime component)
endif
ifeq ($(strip $(KERNEL_RUNTIME_PREREQ)),)
$(error x86_64 kernel link requires nonempty KERNEL_RUNTIME_PREREQ from the root runtime component)
endif
ifeq ($(strip $(KERNEL_RUNTIME_LINK_RECEIPT)),)
$(error x86_64 kernel link requires nonempty KERNEL_RUNTIME_LINK_RECEIPT from the root runtime component)
endif
endif

KERNEL_EXTRA_OBJECTS := \
    $(BUILD_DIR)/kernel/font.o \
    $(BUILD_DIR)/$(ARCHDIR)/trampoline_bin.o

# Arch-specific source files (auto-discovered)
KERNEL_ARCH_SOURCES := \
    $(wildcard $(ARCHDIR)/*.c) \
    $(wildcard $(ARCHDIR)/*.S) \
    $(wildcard $(ARCHDIR)/intr/*.c) \
    $(wildcard $(ARCHDIR)/intr/*.S) \
    $(wildcard $(ARCHDIR)/memory/*.c) \
    $(wildcard $(ARCHDIR)/smp/*.c) \
    $(wildcard $(ARCHDIR)/cpu/*.c) \
    $(wildcard $(ARCHDIR)/cpu/*.S) \
    $(wildcard $(ARCHDIR)/platform/*.c)

# x86 platform controllers and legacy timer/RTC devices, plus the PS/2
# pair: the i8042 shared controller layer and the keyboard driver behind
# it (both are port-I/O 0x60/0x64 based — x86-only by construction).
ARCH_PLATFORM_C_SOURCES := \
    $(wildcard arch/x86_64/intr/apic/*.c) \
    driver/pit.c \
    driver/i8042.c \
    driver/keyboard.c \
    driver/mouse.c

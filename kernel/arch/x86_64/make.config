# ── Architecture: x86_64 ────────────────────────────────────
# Toolchain: shared Clang/LLVM discovery lives in the root toolchain.mk.
# This file is only included for ARCH=x86_64, so the include is unguarded.
ARCH_CONFIG := $(abspath $(lastword $(MAKEFILE_LIST)))
include $(dir $(ARCH_CONFIG))../../../toolchain.mk
OBJFORMAT      ?= elf64-x86-64
ASM            = nasm
ARCH_LINKER    = linker.ld

# Arch-specific CFLAGS
#
# NOTE: -fstack-protector / -fstack-protector-strong is intentionally
# omitted.  With -fpie + -mcmodel=kernel, clang allocates a callee-
# saved register to hold the GOT-based __stack_chk_guard pointer in
# the function prologue.  On large functions the register allocator
# reuses this register for temporaries, so the epilogue canary check
# uses a stale/different pointer → false "stack smashing" crash.
# Correcting this would require a linker script with proper GOT
# handling (not just merging .got into .data) and may involve
# compiler-side fixes.
ARCH_CFLAGS    = -mcmodel=kernel -ffreestanding -mno-red-zone \
                 -Wall -Wextra \
                 -mno-80387 -mno-sse -mno-sse2 -mno-3dnow -mno-mmx -fpie

# Arch-specific linker flags
#
# -static is mandatory: without it the kernel becomes a dynamic PIE with
# unresolved .rela.dyn relocations that objcopy -O binary cannot process.
# (wiki/os01-x86_64-os.md §2)
#
# -Wl,-z,norelro: keep the GOT writable and contiguous; combined with
# -Wl,--no-relax this lets lld emit absolute-address accesses for global
# variables instead of GOT-relative (R_X86_64_GOTPCREL) ones that the
# -mcmodel=kernel + -fpie combination cannot tolerate.  (lld >=17 tightened
# the default GOT-relax policy and would otherwise refuse to convert
# GOTPCREL relocations against variables like `jiffies` or `percpu_data`
# in the final link.)
KERNEL_DRIVER_LDFLAGS := -Wl,-m -Wl,elf_x86_64 -static -Wl,-z,muldefs \
                          -Wl,-z,norelro -Wl,--no-relax
KERNEL_RAW_LDFLAGS    := -m elf_x86_64 -static -z muldefs -z norelro --no-relax
# libgcc.a is not part of the OS01 sysroot; the Clang driver resolves -lgcc
# to the host GCC's private libgcc dir (via gcc's embedded search paths) that
# raw ld.lld does not search. Discover it through the validated CLANG so the
# raw final link can resolve -lgcc exactly as the driver path did. (Commit K
# removes the -lgcc dependency entirely.)
KERNEL_RAW_LIBDIR     := -L$(TARGET_LIBDIR) -L$(dir $(shell $(CLANG) -print-libgcc-file-name))
RAW_LD_EMULATION      := -m elf_x86_64
ARCH_LDFLAGS          = $(KERNEL_DRIVER_LDFLAGS)
ARCH_LIBS             = -nostdlib -lk -lgcc
ARCH_ENABLE_LWIP = 1
KERNEL_EXTRA_OBJECTS := \
    $(BUILD_DIR)/kernel/font.o \
    $(BUILD_DIR)/$(ARCHDIR)/trampoline_bin.o

# Arch-specific source files (auto-discovered)
KERNEL_ARCH_SOURCES := \
    $(wildcard $(ARCHDIR)/*.c) \
    $(wildcard $(ARCHDIR)/*.S)

# x86 platform controllers and legacy timer/RTC devices.
ARCH_PLATFORM_C_SOURCES := \
    $(wildcard intr/apic/*.c) \
    $(wildcard intr/pic/*.c) \
    driver/pit.c \
    driver/rtc.c

# ── Architecture: x86_64 ────────────────────────────────────
# Toolchain.
# Use immediate assignment so the host default CC/LD cannot silently win.
CC             := clang -target x86_64-unknown-none
LD             := ld.lld -m elf_x86_64
OBJFORMAT      ?= elf64-x86-64
ASM            = nasm
ARCH_LINKER    = linker.ld

# Arch-specific CFLAGS
#
# NOTE: -fstack-protector / -fstack-protector-strong is intentionally
# omitted.  With -fpie + -mcmodel=kernel, clang allocates a callee-
# saved register to hold the GOT-based __stack_chk_guard pointer in
# the function prologue.  On large functions the register allocator
# reuses this register for temporaries, so the epilogue canary check
# uses a stale/different pointer → false "stack smashing" crash.
# Correcting this would require a linker script with proper GOT
# handling (not just merging .got into .data) and may involve
# compiler-side fixes.
ARCH_CFLAGS    = -mcmodel=kernel -ffreestanding -mno-red-zone \
                 -Wall -Wextra \
                 -mno-80387 -mno-sse -mno-sse2 -mno-3dnow -mno-mmx -fpie

# Arch-specific linker flags
ARCH_LDFLAGS   = -Wl,-m -Wl,elf_x86_64 -static -Wl,-z,muldefs
ARCH_LIBS      = -nostdlib -lk -lgcc
ARCH_ENABLE_LWIP = 1
KERNEL_EXTRA_OBJECTS := \
    $(BUILD_DIR)/kernel/font.o \
    $(BUILD_DIR)/$(ARCHDIR)/trampoline_bin.o

# Arch-specific source files (auto-discovered)
KERNEL_ARCH_SOURCES := \
    $(wildcard $(ARCHDIR)/*.c) \
    $(wildcard $(ARCHDIR)/*.S)

# x86 platform controllers and legacy timer/RTC devices.
ARCH_PLATFORM_C_SOURCES := \
    $(wildcard intr/apic/*.c) \
    $(wildcard intr/pic/*.c) \
    driver/pit.c \
    driver/rtc.c

# ── Architecture: aarch64 ──────────────────────────────────
# Profile-only guard: the profile was already included by kernel/Makefile via
# OS01_PROFILE_FILE — no local toolchain include. The toolchain is the
# arch-specific pair below (immediate assignment so the host default CC/LD
# cannot silently win) — identical to what the aarch64 profile defines.
ifeq ($(strip $(OS01_PROFILE_FILE)),)
$(error invoke from the repository root: make PROFILE=x86_64-clang <target>)
endif
CC             := clang -target aarch64-none-elf
LD             := ld.lld -m aarch64elf
ASM            = $(CC)
ARCH_LINKER    = linker.ld

# Arch-specific CFLAGS. -fno-pie / -fno-pic: kernel is freestanding and
# must use absolute addressing (no GOT/PLT, no relocations).
ARCH_CFLAGS    = -march=armv8-a -ffreestanding -Wall -Wextra \
                 -mgeneral-regs-only -fno-pie -fno-pic
ARCH_ASMFLAGS  =

# Fault injection changes compiled code. Always profile-clean before
# changing it; object dependencies do not track command-line flag values.
AARCH64_SMP_TEST_NO_ACK_CPU ?= 0
ifneq ($(words $(AARCH64_SMP_TEST_NO_ACK_CPU)),1)
$(error AARCH64_SMP_TEST_NO_ACK_CPU must be exactly one of 0..7)
endif
ifneq ($(filter 0 1 2 3 4 5 6 7,$(AARCH64_SMP_TEST_NO_ACK_CPU)),$(AARCH64_SMP_TEST_NO_ACK_CPU))
$(error AARCH64_SMP_TEST_NO_ACK_CPU must be exactly one of 0..7)
endif
ARCH_CFLAGS += -DAARCH64_SMP_TEST_NO_ACK_CPU=$(AARCH64_SMP_TEST_NO_ACK_CPU)

# Arch-specific linker flags.
# -fuse-ld=lld routes clang through ld.lld (configured via LD in kernel/Makefile).
# -Wl,-m aarch64elf tells the linker-driver which emulation to use.
# -T linker script is supplied via the build rule, not here.
ARCH_LDFLAGS   = -fuse-ld=lld -static -Wl,-z,muldefs -Wl,-m -Wl,aarch64elf
# AAGU-29: aarch64 now links libk.a (kernel-side static libc) the same way
# x86_64 does (kernel/arch/x86_64/make.config: ARCH_LIBS = -nostdlib -lk).
# LIBC_BUILD_DIR is profile-set (mk/profiles/aarch64-clang.mk); libk.a lands
# at $(LIBC_BUILD_DIR)/lib/libk.a once the libc component rule builds it
# (mk/components/image.mk: aarch64-libk build order prerequisite).
# -nostdlib: no implicit libgcc/libc lookup — all kernel libs are explicit.
ARCH_LDFLAGS  += -L$(LIBC_BUILD_DIR)/lib
ARCH_LIBS      = -nostdlib -lk
ARCH_ENABLE_LWIP = 0
KERNEL_EXTRA_OBJECTS :=

# Used by llvm-objcopy in the kernel.bin rule to pick the input BFD target.
OBJFORMAT      = elf64-littleaarch64

# No x86 APIC/PIC/PIT/RTC platform sources on aarch64.
ARCH_PLATFORM_C_SOURCES :=

# ── Architecture: aarch64 ──────────────────────────────────
# Toolchain (no nasm — aarch64 uses clang's integrated assembler).
# ASM := $(CC) lets us reuse the clang invocation for both .c and .S
ASM            = $(CC)
ARCH_LINKER    = linker.ld

# Arch-specific CFLAGS. -fno-pie / -fno-pic: kernel is freestanding and
# must use absolute addressing (no GOT/PLT, no relocations).
ARCH_CFLAGS    = -march=armv8-a -ffreestanding -Wall -Wextra \
                 -mgeneral-regs-only -fno-pie -fno-pic
ARCH_ASMFLAGS  =

# Arch-specific linker flags.
ARCH_LDFLAGS   = -Wl,-m -Wl,aarch64elf -static -Wl,-z,muldefs

# Used by llvm-objcopy in the kernel.bin rule to pick the input BFD target.
OBJFORMAT      = elf64-littleaarch64

# No x86 APIC/PIC/PIT/RTC platform sources on aarch64.
ARCH_PLATFORM_C_SOURCES :=
